# ============================================================
# EXEMPLO de variaveis de ambiente.
# 1) Copia este ficheiro para ".env":   cp .env.example .env
# 2) Preenche os valores reais no .env  (o .env NUNCA vai para o git)
# ============================================================

# --- RPC da Solana -------------------------------------------------
# Comeca com o publico gratuito. Depois trocas para Helius/QuickNode
# so mudando esta linha (o resto do codigo nao muda).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Endpoints Jupiter (agregador de swaps). Raramente precisas de mudar.
JUPITER_QUOTE_URL=https://public.jupiterapi.com/quote
JUPITER_SWAP_URL=https://public.jupiterapi.com/swap

# --- Seguranca do dashboard ---------------------------------------
# O dashboard controla dinheiro real (compras/vendas/envio/mudar p/ REAL).
# COM password: exige login e fica acessivel na rede (telemovel) em 0.0.0.0.
# SEM password (vazio): fica SO em localhost (127.0.0.1), fechado a rede.
# Define uma password FORTE se quiseres aceder de fora do computador.
DASHBOARD_PASSWORD=

# --- Metodo de deteccao de tokens novos ---------------------------
# "polling"   -> pergunta a GeckoTerminal de X em X segundos (fiavel, default)
# "websocket" -> logsSubscribe ao RPC: aviso INSTANTANEO quando nasce um
#                token pump.fun (experimental, so Solana/pump.fun, precisa
#                de um RPC com WebSocket como o Helius; o publico nao serve).
# Podes correr os dois ao mesmo tempo: METODO_DETECCAO=polling,websocket
METODO_DETECCAO=polling
# Endpoint WebSocket do RPC. Se vazio, deriva do SOLANA_RPC_URL (http->ws).
# So preenche se o teu RPC tiver um WS num host diferente.
SOLANA_WS_URL=
# Limite de pedidos RPC/segundo para nao estourar o plano gratuito (Helius)
RPC_MAX_PEDIDOS_POR_SEGUNDO=8
# Cache do preco do SOL (segundos): tira a latencia da cotacao Jupiter do
# caminho de cada compra. O preco quase nao mexe em poucos segundos.
PRECO_SOL_CACHE_SEGUNDOS=8

# --- Envio Jito (transacoes prioritarias, so modo REAL) -----------
# Manda a transacao ao block-engine da Jito com uma gorjeta (tip), em vez
# do RPC normal - entra mais depressa quando a rede esta congestionada.
# So funciona em modo REAL (DRY_RUN=false); no simulado e ignorado.
# DESLIGADO por defeito (pagas o tip so quando ligas de proposito).
JITO_ATIVO=false
# Endpoint publico (sem conta/chave). Regioes alternativas ex:
# https://amsterdam.mainnet.block-engine.jito.wtf
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
# Gorjeta em lamports (1 SOL = 1e9). Minimo Jito = 1000; 100000 (~0.0001
# SOL) e um ponto de partida. Tip demasiado baixo raramente entra.
JITO_TIP_LAMPORTS=100000

# --- COPY TRADING (seguir carteiras "top") ------------------------
# Segue uma lista MANUAL de carteiras; quando uma delas COMPRA um token,
# o bot replica (valor pequeno e fixo) apos uma verificacao minima de
# seguranca (mint+freeze authority revogadas). 4o caminho de compra
# dedicado, isolado dos outros 3. DESLIGADO por defeito.
COPY_TRADE_ATIVO=false
# Carteiras a seguir, separadas por virgula (enderecos Solana base58):
COPY_TRADE_WALLETS=
# Valor (USD) de cada compra copiada
COPY_TRADE_VALOR_USD=1.0
# Limite total (USD) que o copy trade pode gastar por dia - OBRIGATORIO,
# reinicia sozinho a cada dia (UTC), tal como o modo sniper
COPY_TRADE_LIMITE_DIARIO_USD=10.0
# De quantos em quantos segundos sondar cada carteira por compras novas
COPY_TRADE_INTERVALO_SEGUNDOS=5

# --- Camada 1: Groq (PRINCIPAL) + DeepSeek (fallback) - analise primaria,
# corre para TODOS os tokens detetados ------------------------------------
# Groq tenta primeiro (latencia muito baixa); se falhar (erro, rate limit,
# timeout) ou ficar vazio, cai automaticamente para a DeepSeek. So precisas
# de configurar um dos dois - os dois juntos dao mais resiliencia.
# Chave obtida em https://console.groq.com/keys
GROQ_API_KEY=
# Modelo a usar (bom equilibrio velocidade/raciocinio para esta analise)
GROQ_MODEL=llama-3.3-70b-versatile

# Chave obtida em https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Endpoint da API direta da DeepSeek (nao mexer, a nao ser que uses OpenRouter)
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Modelo a usar
DEEPSEEK_MODEL=deepseek-chat

# --- Camada 2: Claude (so corre na zona ambigua) ------------------
# OPCIONAL: se deixares vazio, o bot corre so com a Camada 1 (nao rebenta).
# Chave obtida em https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modelo Sonnet (confirma o ID atual em https://docs.anthropic.com/en/docs/about-claude/models)
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Comportamento do bot -----------------------------------------
# De quantos em quantos segundos procurar pools novos
POLL_INTERVAL_SEGUNDOS=30

# Zona "ambigua" do score da Camada 1 que dispara a Camada 2 (Claude).
# Fora deste intervalo, nao vale a pena gastar a chamada extra ao Claude.
ZONA_AMBIGUA_MIN=40
ZONA_AMBIGUA_MAX=70

# Liquidez minima (em USD) abaixo da qual consideramos arriscado. TAMBEM
# e o piso do caminho de compra normal: tokens com liquidez abaixo disto
# nao sao comprados por ai (o modo bonding curve tem o seu proprio caminho).
LIQUIDEZ_MINIMA_USD=2000

# Sinais on-chain AVANCADOS (liquidez bloqueada via Raydium + historico do
# deployer via Helius) - sao os que mais chamadas RPC/Helius gastam. Poe
# false para conter o custo em 24/7 num plano gratuito (o essencial -
# autoridades + holders - continua a correr). Default true.
ANALISE_ONCHAIN_AVANCADA=true

# --- Cooldown de reanalise ----------------------------------------
# Um token ja analisado nao volta a ser processado (nem gasta IA) dentro
# desta janela, mesmo que reapareca com outro pool. Ver cooldown.py.
COOLDOWN_REANALISE_MINUTOS=10

# --- Trava final do envio real na Solana (Jupiter) ----------------
# Simetrica a PUMPFUN_/BSC_PERMITIR_ENVIO_REAL. Mesmo com DRY_RUN=false,
# as compras/vendas normais (Jupiter) SO saem on-chain se isto for true.
# Fica false ate confirmares que queres mesmo executar com dinheiro real.
# (O bot corre sempre simulateTransaction antes e so abre/fecha a posicao
# depois de a tx CONFIRMAR on-chain.)
SOLANA_PERMITIR_ENVIO_REAL=false
# Tempo (s) a esperar pela confirmacao on-chain antes de a dar como incerta
CONFIRMAR_TX_SEGUNDOS=20

# --- MODO SNIPER RAPIDO ("caveira") - O MAIS ARRISCADO ------------
# Compra quase instantanea, ANTES da analise da IA, por uma checklist
# BINARIA (sim/nao): mint+freeze authority revogadas E liquidez >=
# LIQUIDEZ_MINIMA_CAVEIRA_USD E idade <= IDADE_MAXIMA_CAVEIRA_SEGUNDOS.
# DESLIGADO por defeito. Perdas pequenas e frequentes sao ESPERADAS -
# e o "custo de entrada" para apanhar os poucos tokens que disparam cedo.
SNIPER_RAPIDO_ATIVO=false
SNIPER_RAPIDO_VALOR_USD=1.0
# Limite total (USD) que este modo pode gastar por dia - OBRIGATORIO,
# contem o dano maximo num dia mau. Reinicia sozinho a cada dia (UTC).
SNIPER_RAPIDO_LIMITE_DIARIO_USD=10.0
# Se a IA (depois da compra) devolver um score acima disto, vende ja.
# Descido de 70 para 50 apos diagnostico real (win rate 17.6%) - a rede
# de seguranca so disparava em casos extremos, agora corta mais cedo.
SNIPER_RAPIDO_SCORE_VENDA_URGENTE=50
# Criterios da checklist binaria. LIQUIDEZ subida de 1000 para 2000
# (igual ao modo normal) apos diagnostico - liquidez tao fina dava pouca
# margem antes do preco reagir a qualquer venda.
LIQUIDEZ_MINIMA_CAVEIRA_USD=2000
IDADE_MAXIMA_CAVEIRA_SEGUNDOS=60

# --- Filtro de QUALIDADE do Caveira (momentum real, nao so tecnico) ---
# A checklist acima filtra scams TECNICOS mas nao qualidade - a maioria
# dos tokens passa isso nos primeiros segundos, incluindo os que morrem
# sem ninguem comprar. Estes sinais extra pedem atividade REAL antes de
# entrar. TRADE-OFF: torna o Caveira mais LENTO (espera + RPC extra) mas
# mais SELETIVO. Poe um valor a 0 (ou 100 no top-holder) para desligar
# esse sinal especifico e voltar ao comportamento antigo (so velocidade).
#
# VALORES APERTADOS apos diagnostico real (68 compras, win rate 17.6%,
# -13.71%): os limiares antigos (3 compradores, 5 tx) eram trivialmente
# atingidos so por OUTROS BOTS DE SNIPE (que disparam em qualquer token
# novo do pump.fun, bom ou mau), dando falsa confianca. Alem disso o
# main.py mudou de fail-open para FAIL-CLOSED quando o RPC falha - por
# isso num RPC publico o Caveira pode passar a comprar bem menos. Se
# quiseres que dispare com regularidade, usa um RPC melhor (Helius).
CAVEIRA_JANELA_MOMENTUM_SEGUNDOS=8
CAVEIRA_RATIO_COMPRA_VENDA_MIN=3.0
CAVEIRA_COMPRADORES_UNICOS_MIN=6
CAVEIRA_TOP_HOLDER_MAX_PCT=30.0
CAVEIRA_TRANSACOES_MIN=12

# --- Deteccao de reversao (saida antecipada por volume de venda) --
# Alem do stop-loss/take-profit/trailing normais de uma posicao aberta,
# deteta se as VENDAS comecarem a superar claramente as compras (reutiliza
# momentum.py) e vende mais cedo, mesmo sem atingir o take-profit normal -
# sinal de que outros estao a sair. DESLIGADO por defeito - e um sinal
# HEURISTICO extra e custa chamadas RPC extra POR POSICAO ABERTA a cada
# verificacao (INTERVALO_VERIFICAR_POSICOES).
DETECAO_REVERSAO_ATIVA=false
REVERSAO_RATIO_VENDA_MIN=2.0
REVERSAO_VENDAS_MIN=3

# --- Venda automatica por TEMPO sem valorizacao --------------------
# Independente do stop-loss/take-profit: se uma posicao estiver aberta ha
# mais deste tempo E o preco NAO estiver acima do preco de compra (sem
# lucro nenhum), vende 100% - nao deixa dinheiro parado indefinidamente.
# Aplica-se a TODOS os modos de compra. Poe um valor muito alto (ex:
# 999999) para desativar.
TEMPO_MAXIMO_SEM_LUCRO_HORAS=2.0

# --- Modo de SAIDA de uma posicao (como sair de uma posicao a subir) ---
# "take_profit_parcial" (default) -> comportamento original: ao atingir
#   TAKE_PROFIT_MULTIPLICADOR vende so TAKE_PROFIT_VENDER_PCT% e so DEPOIS
#   disso ativa um trailing stop (TRAILING_STOP_PCT) sobre o resto.
# "trailing_puro" -> NUNCA vende parcialmente. So vende 100% quando o preco
#   cair TRAILING_PURO_PCT% do pico mais alto ja atingido (ignora
#   TAKE_PROFIT_MULTIPLICADOR/VENDER_PCT). Exemplo: compra a $1, sobe a $3
#   (pico) -> nivel de stop fica em $2.10 (30% abaixo do pico); se cair
#   para $2.09 vende tudo. Se em vez disso nunca subir, e o STOP_LOSS_PCT
#   normal (desde o preco de COMPRA, nao do pico) que dispara - continua
#   ativo em AMBOS os modos como rede de seguranca.
MODO_SAIDA=take_profit_parcial
# So usado quando MODO_SAIDA=trailing_puro
TRAILING_PURO_PCT=30.0

# --- Alertas Telegram (opcional, gratuito) -------------------------
# Notifica compra/venda/erro grave/mudanca de saldo via Telegram Bot API.
# Guia de configuracao completo em telegram_alerts.py. Sem isto o bot
# funciona igual, so sem notificacoes.
TELEGRAM_ALERTAS_ATIVO=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Uma venda cujo lucro/prejuizo represente >= esta % do saldo atual
# dispara um aviso extra destacado ("mudanca significativa")
TELEGRAM_ALERTA_SALDO_PCT=10.0

# --- BSC (Binance Smart Chain) - Parte B, multi-chain -------------
# Ver o guia rapido de ativacao no resumo da sessao / historico do chat.
# Redes a monitorizar em paralelo. So Solana por defeito; poe
# "solana,bsc" para ligar a deteccao e analise tambem na BSC.
REDES_ATIVAS=solana
# RPC publico gratuito por defeito. Funciona, mas pode ser lento/instavel
# sob carga - considera um privado (ex: Ankr, QuickNode) se usares a
# serio.
BSC_RPC_URL=https://bsc-dataseed.binance.org
# Chave privada da wallet BSC - gera com "python3 gerar_wallet_bsc.py".
# NUNCA reutilizes a mesma chave da Solana nem uma wallet que ja uses
# noutro lado - cria uma NOVA, dedicada so a este bot.
WALLET_PRIVATE_KEY_BSC=
# Limite por trade na BSC (independente do MAX_TRADE_USD da Solana)
BSC_MAX_TRADE_USD=5.0
# Trava final do envio real na BSC (como as outras vias): mesmo com
# DRY_RUN=false, so envia on-chain se isto for true. FICA false ate
# testares bem em DRY_RUN - o caminho real da BSC e o menos validado do
# projeto (ver aviso no guia de ativacao).
BSC_PERMITIR_ENVIO_REAL=false
