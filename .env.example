# ============================================================
# EXEMPLO de variaveis de ambiente.
# 1) Copia este ficheiro para ".env":   cp .env.example .env
# 2) Preenche os valores reais no .env  (o .env NUNCA vai para o git)
# ============================================================

# --- RPC da Solana -------------------------------------------------
# Comeca com o publico gratuito. Depois trocas para Helius/QuickNode
# so mudando esta linha (o resto do codigo nao muda).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Camada 1: DeepSeek (analise primaria, corre para TODOS os tokens) ---
# Chave obtida em https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Endpoint da API direta da DeepSeek (nao mexer, a nao ser que uses OpenRouter)
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Modelo a usar
DEEPSEEK_MODEL=deepseek-chat

# --- Camada 2: Claude (so corre na zona ambigua) ------------------
# OPCIONAL: se deixares vazio, o bot corre so com a Camada 1 (nao rebenta).
# Chave obtida em https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modelo Sonnet (confirma o ID atual em https://docs.anthropic.com/en/docs/about-claude/models)
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Comportamento do bot -----------------------------------------
# De quantos em quantos segundos procurar pools novos
POLL_INTERVAL_SEGUNDOS=30

# Zona "ambigua" do score da Camada 1 que dispara a Camada 2 (Claude).
# Fora deste intervalo, nao vale a pena gastar a chamada extra ao Claude.
ZONA_AMBIGUA_MIN=40
ZONA_AMBIGUA_MAX=70

# Liquidez minima (em USD) abaixo da qual consideramos arriscado
LIQUIDEZ_MINIMA_USD=2000

# --- Cooldown de reanalise ----------------------------------------
# Um token ja analisado nao volta a ser processado (nem gasta IA) dentro
# desta janela, mesmo que reapareca com outro pool. Ver cooldown.py.
COOLDOWN_REANALISE_MINUTOS=10

# --- MODO SNIPER RAPIDO ("caveira") - O MAIS ARRISCADO ------------
# Compra quase instantanea, ANTES da analise da IA, por uma checklist
# BINARIA (sim/nao): mint+freeze authority revogadas E liquidez >=
# LIQUIDEZ_MINIMA_CAVEIRA_USD E idade <= IDADE_MAXIMA_CAVEIRA_SEGUNDOS.
# DESLIGADO por defeito. Perdas pequenas e frequentes sao ESPERADAS -
# e o "custo de entrada" para apanhar os poucos tokens que disparam cedo.
SNIPER_RAPIDO_ATIVO=false
SNIPER_RAPIDO_VALOR_USD=1.0
# Limite total (USD) que este modo pode gastar por dia - OBRIGATORIO,
# contem o dano maximo num dia mau. Reinicia sozinho a cada dia (UTC).
SNIPER_RAPIDO_LIMITE_DIARIO_USD=10.0
# Se a IA (depois da compra) devolver um score acima disto, vende ja
SNIPER_RAPIDO_SCORE_VENDA_URGENTE=70
# Criterios da checklist binaria (podem ser mais permissivos que o
# modo normal - aceita-se mais risco em troca de entrar cedo)
LIQUIDEZ_MINIMA_CAVEIRA_USD=1000
IDADE_MAXIMA_CAVEIRA_SEGUNDOS=60
